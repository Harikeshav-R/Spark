{
  "name": "spark",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch server/index.ts",
    "build:server": "esbuild server/index.ts scripts/doctor.ts --bundle --platform=node --target=node24 --format=esm --packages=external --outbase=. --outdir=dist --sourcemap",
    "build": "npm run build:server && next build",
    "start": "NODE_ENV=production node --enable-source-maps dist/server/index.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:contracts": "vitest run tests/contracts",
    "test:integration": "vitest run tests/integration",
    "test:e2e": "playwright test",
    "check": "npm run typecheck && npm run lint && npm test && npm run test:contracts",
    "doctor": "tsx scripts/doctor.ts",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:seed": "tsx scripts/seed.ts",
    "demo": "tsx scripts/demo.ts",
    "demo:reset": "tsx scripts/reset-demo.ts",
    "demo:record": "playwright test tests/e2e/demo.spec.ts",
    "setup:agents": "node scripts/setup-agent-tooling.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.48.0",
    "d3-force": "3.0.0",
    "dotenv": "^18.0.8",
    "express": "^5.0.1",
    "katex": "0.16.47",
    "motion": "14.6.0",
    "multer": "^2.5.0",
    "next": "^16.1.6",
    "openai": "7.41.0",
    "pdf-lib": "1.17.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "remark": "15.0.1",
    "remark-math": "6.0.0",
    "socket.io": "^4.8.1",
    "socket.io-client": "^4.8.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/d3-force": "3.0.10",
    "@types/express": "^5.0.0",
    "@types/katex": "0.16.8",
    "@types/mdast": "4.0.4",
    "@types/multer": "^2.3.0",
    "@types/node": "^26.6.5",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "clsx": "^2.1.1",
    "esbuild": "0.28.2",
    "eslint": "^10.13.0",
    "happy-dom": "21.0.4",
    "postcss": "^8.5.31",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.19.3",
    "typescript": "~5.8.2",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.0.5"
  },
  "allowScripts": {
    "esbuild": true
  }
}
